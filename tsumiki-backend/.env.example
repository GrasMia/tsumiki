# 应用配置
APP_NAME="tsumiki"
VERSION="0.2.0"
DEBUG=false
SECRET_KEY="your-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_PREFIX="Bearer"
# 数据库配置
DATABASE_URL="your-database-url"

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=15
UPLOAD_FILE_CHUNK_SIZE=5
TRASHES_EXPIRES_DAYS=10
AVAILABLE_GB_SPACE=20
FILE_MAX_MB_SIZE=500

# 文件存储配置 (本地)
LOCAL_STORAGE_PATH="./wwwroot/files"
LOCAL_AVATAR_PATH="./wwwroot/avatars"
LOCAL_STATIC_PATH="./wwwroot/static"

# 文件上传配置 (单位：MB)
UPLOAD_FILE_CHUNK_SIZE=2